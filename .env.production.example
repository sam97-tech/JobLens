# قالب توثيقي فقط — لا يحوي أي أسرار حقيقية.
# الملف الفعلي يُنشأ يدويًا على السيرفر بالمسار ~/app/env.production
# (خارج مستودع GitHub تمامًا، حسب دليل الاستضافة) بقيم حقيقية.

APP_NAME=JobLens
APP_ENV=production
APP_KEY=                # نتيجة: php artisan key:generate --show
APP_DEBUG=false
APP_URL=https://YOUR-DOMAIN

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=db               # اسم خدمة قاعدة البيانات داخل compose.yaml، وليس 127.0.0.1
DB_PORT=3306
DB_DATABASE=joblens
DB_USERNAME=joblens
DB_PASSWORD=             # كلمة مرور قوية مستقلة لهذا المشروع فقط

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_DOMAIN=null

FILESYSTEM_DISK=public
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log

# اسم خدمة AI داخل compose.yaml، وليس 127.0.0.1 — الحاويتان تتواصلان
# عبر شبكة Docker الداخلية باسم الخدمة
AI_MATCHING_URL=http://ai:8500
